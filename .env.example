# Environment Configuration Template for SKYGUARD
# Copy this file to .env and configure local environment variables.

# Core System
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api/v1

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# Simulator Configuration
SIMULATOR_TICK_RATE_MS=1000
SIMULATOR_NUM_STATIONS=5

# Edge / Hardware Ingestion (Testbed)
EDGE_SERIAL_PORT=COM3
EDGE_BAUD_RATE=115200
